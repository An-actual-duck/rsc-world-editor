{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsc-world-editor.invalid/world-builder/import-receipt-v3.schema.json",
  "title": "World Builder adaptive import receipt v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "manifestType", "transactionId", "transactionType", "status",
    "createdAtUtc", "projectId", "exportFingerprintSha256", "mutationPlanSha256",
    "adapterId", "capabilityId", "targetLineageSha256", "selectedConfiguration",
    "mutationOccurred", "offlineEvidence", "files", "configurationChanges",
    "verificationResults", "revertsTransactionId", "recoveryTransactionId",
    "receiptFingerprintSha256"
  ],
  "properties": {
    "schemaVersion": {"const": 3},
    "manifestType": {"const": "world-builder-adaptive-import-receipt"},
    "transactionId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/uuid"},
    "transactionType": {"enum": ["import", "recovery", "undo"]},
    "status": {
      "enum": [
        "failed-no-change", "pending", "recovery-required", "reverted",
        "rolled-back", "successful"
      ]
    },
    "createdAtUtc": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/timestamp"},
    "projectId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/uuid"},
    "exportFingerprintSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
    "mutationPlanSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
    "adapterId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
    "capabilityId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
    "targetLineageSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
    "selectedConfiguration": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/roleStateReference"},
    "mutationOccurred": {"type": "boolean"},
    "offlineEvidence": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {"$ref": "#/$defs/offlineEvidence"}
    },
    "files": {
      "type": "array", "minItems": 1, "maxItems": 4096,
      "items": {"$ref": "#/$defs/receiptFile"}
    },
    "configurationChanges": {
      "type": "array", "maxItems": 4096,
      "items": {"$ref": "#/$defs/configurationChange"}
    },
    "verificationResults": {
      "type": "array", "maxItems": 4096,
      "items": {"$ref": "#/$defs/verificationResult"}
    },
    "revertsTransactionId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/optionalUuid"},
    "recoveryTransactionId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/optionalUuid"},
    "receiptFingerprintSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"mutationOccurred": {"const": true}}},
      "then": {
        "properties": {
          "offlineEvidence": {
            "items": {"properties": {"verified": {"const": true}}}
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "failed-no-change"}}},
      "then": {"properties": {"mutationOccurred": {"const": false}}}
    },
    {
      "if": {"properties": {"status": {"const": "successful"}}},
      "then": {
        "properties": {
          "mutationOccurred": {"const": true},
          "files": {"items": {"properties": {"afterVerified": {"const": true}}}},
          "configurationChanges": {
            "items": {"properties": {"afterVerified": {"const": true}}}
          },
          "verificationResults": {
            "minItems": 1,
            "items": {"properties": {"success": {"const": true}}}
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"enum": ["reverted", "rolled-back"]}}},
      "then": {
        "properties": {
          "mutationOccurred": {"const": true},
          "files": {
            "items": {"properties": {"rollbackVerified": {"const": true}}}
          },
          "configurationChanges": {
            "items": {"properties": {"rollbackVerified": {"const": true}}}
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "recovery-required"}}},
      "then": {"properties": {"mutationOccurred": {"const": true}}}
    }
  ],
  "$defs": {
    "offlineEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "observed", "verified"],
      "properties": {
        "kind": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
        "observed": {"type": "string", "minLength": 1, "maxLength": 4096},
        "verified": {"type": "boolean"}
      }
    },
    "receiptFile": {
      "type": "object", "additionalProperties": false,
      "required": [
        "role", "relativePath", "before", "after", "backupRelativePath",
        "backupSha256", "afterVerified", "rollbackVerified"
      ],
      "properties": {
        "role": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
        "relativePath": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/relativePath"},
        "before": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/fileState"},
        "after": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/fileState"},
        "backupRelativePath": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/optionalRelativePath"},
        "backupSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/optionalSha256"},
        "afterVerified": {"type": "boolean"},
        "rollbackVerified": {"type": "boolean"}
      }
    },
    "configurationChange": {
      "type": "object", "additionalProperties": false,
      "required": [
        "sequence", "configurationRelativePath", "key", "beforePresent", "beforeValue",
        "afterPresent", "afterValue", "afterVerified", "rollbackVerified"
      ],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0, "maximum": 4095},
        "configurationRelativePath": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/relativePath"},
        "key": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
        "beforePresent": {"type": "boolean"},
        "beforeValue": {"type": "string", "maxLength": 4096},
        "afterPresent": {"type": "boolean"},
        "afterValue": {"type": "string", "maxLength": 4096},
        "afterVerified": {"type": "boolean"},
        "rollbackVerified": {"type": "boolean"}
      }
    },
    "verificationResult": {
      "type": "object", "additionalProperties": false,
      "required": ["verificationId", "success", "observed"],
      "properties": {
        "verificationId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
        "success": {"type": "boolean"},
        "observed": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    }
  }
}
