{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsc-world-editor.invalid/world-builder/target-mutation-plan-v1.schema.json",
  "title": "World Builder target mutation plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "manifestType", "transactionId", "projectId",
    "exportFingerprintSha256", "adapterId", "capabilityId", "mutationProfileId",
    "targetLineageSha256", "selectedConfiguration", "requirements", "actions",
    "createdDirectories",
    "configurationChanges", "backupRootRelativePath", "receiptRelativePath",
    "postWriteVerifications", "rollbackVerifications", "planFingerprintSha256"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "manifestType": {"const": "world-builder-target-mutation-plan"},
    "transactionId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/uuid"},
    "projectId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/uuid"},
    "exportFingerprintSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
    "adapterId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
    "capabilityId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
    "mutationProfileId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
    "targetLineageSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
    "selectedConfiguration": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/roleStateReference"},
    "requirements": {"$ref": "#/$defs/requirements"},
    "actions": {
      "type": "array", "minItems": 1, "maxItems": 4096,
      "items": {"$ref": "#/$defs/action"}
    },
    "createdDirectories": {
      "type": "array", "maxItems": 4096, "uniqueItems": true,
      "items": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/relativePath"}
    },
    "configurationChanges": {
      "type": "array", "maxItems": 4096,
      "items": {"$ref": "#/$defs/configurationChange"}
    },
    "backupRootRelativePath": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/relativePath"},
    "receiptRelativePath": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/relativePath"},
    "postWriteVerifications": {
      "type": "array", "minItems": 1, "maxItems": 4096,
      "items": {"$ref": "#/$defs/verification"}
    },
    "rollbackVerifications": {
      "type": "array", "minItems": 1, "maxItems": 4096,
      "items": {"$ref": "#/$defs/verification"}
    },
    "planFingerprintSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"}
  },
  "$defs": {
    "requirements": {
      "type": "object", "additionalProperties": false,
      "required": [
        "loaderId", "protocolId", "definitionCatalogId", "clientBuildId",
        "offlineEvidence", "requiredFreeSpaceBytes"
      ],
      "properties": {
        "loaderId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
        "protocolId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
        "definitionCatalogId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
        "clientBuildId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
        "offlineEvidence": {
          "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
          "items": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"}
        },
        "requiredFreeSpaceBytes": {
          "type": "integer", "minimum": 0, "maximum": 68719476736
        }
      }
    },
    "action": {
      "type": "object", "additionalProperties": false,
      "required": [
        "sequence", "role", "destinationRelativePath", "before", "after",
        "contentRelativePath", "backupRelativePath", "activation"
      ],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0, "maximum": 4095},
        "role": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
        "destinationRelativePath": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/relativePath"},
        "before": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/fileState"},
        "after": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/fileState"},
        "contentRelativePath": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/optionalRelativePath"},
        "backupRelativePath": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/optionalRelativePath"},
        "activation": {"type": "boolean"}
      }
    },
    "configurationChange": {
      "type": "object", "additionalProperties": false,
      "required": [
        "sequence", "configurationRelativePath", "key", "beforePresent", "beforeValue",
        "afterPresent", "afterValue"
      ],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0, "maximum": 4095},
        "configurationRelativePath": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/relativePath"},
        "key": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
        "beforePresent": {"type": "boolean"},
        "beforeValue": {"type": "string", "maxLength": 4096},
        "afterPresent": {"type": "boolean"},
        "afterValue": {"type": "string", "maxLength": 4096}
      }
    },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["verificationId", "relativePath", "expected"],
      "properties": {
        "verificationId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
        "relativePath": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/relativePath"},
        "expected": {
          "type": "string",
          "pattern": "^absent$|^[0-9a-f]{64}$"
        }
      }
    }
  }
}
