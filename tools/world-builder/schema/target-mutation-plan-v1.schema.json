{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsc-world-editor.invalid/world-builder/target-mutation-plan-v1.schema.json",
  "title": "World Builder target mutation plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "manifestType", "transactionId", "projectId",
    "exportFingerprintSha256", "adapterId", "capabilityId", "mutationProfileId",
    "targetLineageSha256", "selectedConfiguration", "requirements", "actions",
    "createdDirectories",
    "configurationChanges", "backupRootRelativePath", "receiptRelativePath",
    "postWriteVerifications", "rollbackVerifications", "planFingerprintSha256"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "manifestType": {"const": "world-builder-target-mutation-plan"},
    "transactionId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/uuid"},
    "projectId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/uuid"},
    "exportFingerprintSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
    "adapterId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
    "capabilityId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
    "mutationProfileId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
    "targetLineageSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
    "selectedConfiguration": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/roleStateReference"},
    "requirements": {"$ref": "#/$defs/requirements"},
    "runtimeReverification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputs", "inventories"],
      "oneOf": [
        {
          "required": [
            "predecessor"
          ],
          "not": {
            "required": [
              "snapshotPredecessor"
            ]
          }
        },
        {
          "required": [
            "snapshotPredecessor"
          ],
          "not": {
            "required": [
              "predecessor"
            ]
          }
        }
      ],
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "baseline"
              ],
              "not": {
                "required": [
                  "snapshotBaseline"
                ]
              }
            },
            {
              "required": [
                "snapshotBaseline"
              ],
              "not": {
                "required": [
                  "baseline"
                ]
              }
            }
          ]
        },
        {
          "if": {
            "required": [
              "snapshotPredecessor"
            ],
            "not": {
              "required": [
                "baselineProject"
              ]
            }
          },
          "then": {
            "required": [
              "snapshotBaseline"
            ]
          }
        },
        {
          "if": {
            "required": [
              "snapshotPredecessor"
            ],
            "not": {
              "required": [
                "baselineProject"
              ]
            }
          },
          "then": {
            "properties": {
              "snapshotPredecessor": {
                "not": {
                  "required": [
                    "originSha256"
                  ]
                }
              }
            }
          },
          "else": {
            "if": {
              "required": [
                "snapshotPredecessor"
              ]
            },
            "then": {
              "properties": {
                "snapshotPredecessor": {
                  "required": [
                    "originSha256"
                  ]
                }
              }
            }
          }
        }
      ],
      "properties": {
        "snapshotBaseline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "projectId",
            "sourceFingerprintSha256",
            "proofRelativePath",
            "proofSha256",
            "archives"
          ],
          "properties": {
            "projectId": {
              "$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/uuid"
            },
            "sourceFingerprintSha256": {
              "$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"
            },
            "proofRelativePath": {
              "const": "source/original/server/conf/world-builder/installed-target-map-integration-v1.json"
            },
            "proofSha256": {
              "$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"
            },
            "archives": {
              "type": "array",
              "minItems": 1,
              "maxItems": 512,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "relativePath",
                  "size",
                  "sha256"
                ],
                "properties": {
                  "relativePath": {
                    "allOf": [
                      {
                        "$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/relativePath"
                      },
                      {
                        "pattern": "^(?!.*(?:^|/)\\.\\.?(?:/|$))source/original/.+\\.jar$"
                      }
                    ]
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 268435456
                  },
                  "sha256": {
                    "$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"
                  }
                }
              }
            }
          }
        },
        "producerArchiveBinding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "relativePath",
            "before",
            "after",
            "beforeContentRelativePath",
            "contentRelativePath"
          ],
          "properties": {
            "relativePath": {
              "enum": [
                "world-builder-provider/npc-definitions-v2.json",
                "server/conf/world-builder/npc-definitions-v2.json"
              ]
            },
            "before": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "present",
                "size",
                "sha256"
              ],
              "properties": {
                "present": {
                  "const": true
                },
                "size": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 16777216
                },
                "sha256": {
                  "$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"
                }
              }
            },
            "after": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "present",
                "size",
                "sha256"
              ],
              "properties": {
                "present": {
                  "const": true
                },
                "size": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 16777216
                },
                "sha256": {
                  "$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"
                }
              }
            },
            "beforeContentRelativePath": {
              "$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/relativePath"
            },
            "contentRelativePath": {
              "$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/relativePath"
            },
            "predecessor": {
              "$ref": "#/properties/runtimeUpgradeHistory/items"
            }
          }
        },
        "snapshotPredecessor": {
          "type": "object", "additionalProperties": false,
          "required": ["projectId", "sourceFingerprintSha256"],
          "properties": {
            "projectId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/uuid"},
            "sourceFingerprintSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
            "originSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"}
          }
        },
        "baselineProject": {
          "type": "object", "additionalProperties": false,
          "required": ["projectId", "sourceFingerprintSha256", "lineage"],
          "properties": {
            "projectId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/uuid"},
            "sourceFingerprintSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
            "lineage": {
              "type": "array", "minItems": 1, "maxItems": 16,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["projectId", "sourceFingerprintSha256", "originSha256"],
                "properties": {
                  "projectId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/uuid"},
                  "sourceFingerprintSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
                  "originSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"}
                }
              }
            }
          }
        },
        "predecessor": {
          "$ref": "#/properties/runtimeUpgradeHistory/items"
        },
        "baseline": {
          "$ref": "#/properties/runtimeUpgradeHistory/items"
        },
        "inputs": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 100000,
          "propertyNames": {
            "$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/relativePath"
          },
          "additionalProperties": {
            "$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/fileState"
          }
        },
        "inventories": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "relativePath",
              "suffix",
              "recursive",
              "paths"
            ],
            "properties": {
              "relativePath": {
                "$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/relativePath"
              },
              "suffix": {
                "enum": [
                  ".jar",
                  ".java"
                ]
              },
              "recursive": {
                "type": "boolean"
              },
              "paths": {
                "type": "array",
                "maxItems": 16000,
                "uniqueItems": true,
                "items": {
                  "$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/relativePath"
                }
              }
            }
          }
        }
      }
    },
    "runtimeUpgradeHistory": {
      "type": "array", "minItems": 1, "maxItems": 4096,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["transactionId", "receiptSha256", "mutationPlanSha256"],
        "properties": {
          "transactionId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/uuid"},
          "receiptSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
          "mutationPlanSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"}
        }
      }
    },
    "inheritedTargetState": {
      "type": "object", "additionalProperties": false,
      "required": ["projectId", "projectFingerprintSha256", "transactionId", "receiptSha256", "mutationPlanSha256", "files"],
      "properties": {
        "runtimeUpgradeHistory": {"$ref": "#/properties/runtimeUpgradeHistory"},
        "projectId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/uuid"},
        "projectFingerprintSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
        "transactionId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/uuid"},
        "receiptSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
        "mutationPlanSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
        "successors": {"type": "array", "minItems": 1, "maxItems": 16, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["projectId", "transactionId", "receiptSha256", "mutationPlanSha256"],
          "properties": {
            "projectId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/uuid"},
            "transactionId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/uuid"},
            "receiptSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
            "mutationPlanSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"}
          }
        }},
        "files": {"type": "array", "minItems": 1, "maxItems": 8192, "items": {
          "type": "object", "additionalProperties": false, "required": ["relativePath", "state"],
          "properties": {
            "relativePath": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/relativePath"},
            "state": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/fileState"}
          }
        }}
      }
    },
    "actions": {
      "type": "array", "minItems": 1, "maxItems": 4096,
      "items": {"$ref": "#/$defs/action"}
    },
    "createdDirectories": {
      "type": "array", "maxItems": 4096, "uniqueItems": true,
      "items": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/relativePath"}
    },
    "configurationChanges": {
      "type": "array", "maxItems": 4096,
      "items": {"$ref": "#/$defs/configurationChange"}
    },
    "backupRootRelativePath": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/relativePath"},
    "receiptRelativePath": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/relativePath"},
    "postWriteVerifications": {
      "type": "array", "minItems": 1, "maxItems": 4096,
      "items": {"$ref": "#/$defs/verification"}
    },
    "rollbackVerifications": {
      "type": "array", "minItems": 1, "maxItems": 4096,
      "items": {"$ref": "#/$defs/verification"}
    },
    "planFingerprintSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"}
  },
  "$defs": {
    "requirements": {
      "type": "object", "additionalProperties": false,
      "required": [
        "loaderId", "protocolId", "definitionCatalogId", "clientBuildId",
        "offlineEvidence", "requiredFreeSpaceBytes"
      ],
      "properties": {
        "loaderId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
        "protocolId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
        "definitionCatalogId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
        "clientBuildId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
        "offlineEvidence": {
          "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
          "items": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"}
        },
        "requiredFreeSpaceBytes": {
          "type": "integer", "minimum": 0, "maximum": 68719476736
        }
      }
    },
    "action": {
      "type": "object", "additionalProperties": false,
      "required": [
        "sequence", "role", "destinationRelativePath", "before", "after",
        "contentRelativePath", "backupRelativePath", "activation"
      ],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0, "maximum": 4095},
        "role": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
        "destinationRelativePath": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/relativePath"},
        "before": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/fileState"},
        "after": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/fileState"},
        "contentRelativePath": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/optionalRelativePath"},
        "backupRelativePath": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/optionalRelativePath"},
        "activation": {"type": "boolean"}
      }
    },
    "configurationChange": {
      "type": "object", "additionalProperties": false,
      "required": [
        "sequence", "configurationRelativePath", "key", "beforePresent", "beforeValue",
        "afterPresent", "afterValue"
      ],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0, "maximum": 4095},
        "configurationRelativePath": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/relativePath"},
        "key": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
        "beforePresent": {"type": "boolean"},
        "beforeValue": {"type": "string", "maxLength": 4096},
        "afterPresent": {"type": "boolean"},
        "afterValue": {"type": "string", "maxLength": 4096}
      }
    },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["verificationId", "relativePath", "expected"],
      "properties": {
        "verificationId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
        "relativePath": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/relativePath"},
        "expected": {
          "type": "string",
          "pattern": "^absent$|^[0-9a-f]{64}$"
        }
      }
    }
  }
}
