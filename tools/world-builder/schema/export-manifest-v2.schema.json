{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsc-world-editor.invalid/world-builder/export-manifest-v2.schema.json",
  "title": "World Builder adaptive export manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "manifestType", "toolVersion", "projectId", "origin",
    "adapterId", "capabilityId", "installProfileId", "lineage",
    "packageManifestSha256", "packageFingerprintSha256", "files",
    "validationReports", "exportFingerprintSha256"
  ],
  "properties": {
    "schemaVersion": {"const": 2},
    "manifestType": {"const": "world-builder-adaptive-export"},
    "toolVersion": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
    "projectId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/uuid"},
    "origin": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/origin"},
    "adapterId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/optionalIdentifier"},
    "capabilityId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/optionalIdentifier"},
    "installProfileId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/optionalIdentifier"},
    "lineage": {
      "type": "object", "additionalProperties": false,
      "required": [
        "sourceSha256", "layeredBaselineSha256", "conversionSha256",
        "definitionsRuntimeSha256", "workingSha256"
      ],
      "properties": {
        "sourceSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
        "layeredBaselineSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
        "conversionSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/optionalSha256"},
        "definitionsRuntimeSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
        "workingSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"}
      }
    },
    "packageManifestSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
    "packageFingerprintSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
    "files": {
      "type": "array", "minItems": 1, "maxItems": 8192,
      "items": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/inventoryRecord"}
    },
    "validationReports": {
      "type": "array", "maxItems": 256,
      "items": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/hashRecord"}
    },
    "exportFingerprintSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"}
  }
}
