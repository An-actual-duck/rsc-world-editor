{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsc-world-editor.invalid/world-builder/npc-animation-registry-v1.schema.json",
  "title": "World Builder NPC animation registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifestType", "animations"],
  "properties": {
    "schemaVersion": {"const": 1},
    "manifestType": {"const": "world-builder-npc-animation-registry"},
    "animations": {
      "type": "array", "minItems": 1, "maxItems": 65536,
      "items": {"$ref": "#/$defs/animation"}
    }
  },
  "$defs": {
    "runtimeId": {"type": "integer", "minimum": 0, "maximum": 65535},
    "signedInteger": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
    "archiveName": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "animationId", "name", "category", "charColour", "blueMask",
        "genderModel", "hasCombatFrames", "hasSpecialCombatFrames",
        "requiredFrameCount", "customSpriteSubspace", "customSpriteEntry",
        "customEntrySha256", "authenticBaseSpriteId",
        "authenticFrameSha256s"
      ],
      "properties": {
        "animationId": {"$ref": "#/$defs/runtimeId"},
        "name": {"$ref": "#/$defs/archiveName"},
        "category": {"$ref": "#/$defs/archiveName"},
        "charColour": {"$ref": "#/$defs/signedInteger"},
        "blueMask": {"$ref": "#/$defs/signedInteger"},
        "genderModel": {"$ref": "#/$defs/signedInteger"},
        "hasCombatFrames": {"type": "boolean"},
        "hasSpecialCombatFrames": {"type": "boolean"},
        "requiredFrameCount": {"enum": [15, 18, 27]},
        "customSpriteSubspace": {"$ref": "#/$defs/archiveName"},
        "customSpriteEntry": {"$ref": "#/$defs/archiveName"},
        "customEntrySha256": {"$ref": "#/$defs/sha256"},
        "authenticBaseSpriteId": {"$ref": "#/$defs/runtimeId"},
        "authenticFrameSha256s": {
          "type": "array", "minItems": 15, "maxItems": 27,
          "items": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  }
}
