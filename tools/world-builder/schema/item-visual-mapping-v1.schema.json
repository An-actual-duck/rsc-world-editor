{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsc-world-editor.invalid/world-builder/item-visual-mapping-v1.schema.json",
  "title": "Neutral World Builder item-visual provider v1",
  "$comment": "Producer schema. Consumers quarantine safely invalid manifests or records into deterministic project-local placeholders and warnings rather than opening untrusted paths or blocking project launch.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifestType", "itemVisuals"],
  "properties": {
    "schemaVersion": {"const": 1},
    "manifestType": {"const": "world-builder-item-visual-mapping"},
    "itemVisuals": {
      "type": "array",
      "maxItems": 65536,
      "items": {"$ref": "#/$defs/itemVisual"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "portablePath": {
      "type": "string", "minLength": 1, "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[. ](?:/|$))(?!.*\\\\)[A-Za-z0-9._ -]+(?:/[A-Za-z0-9._ -]+)*$"
    },
    "itemVisual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemId", "name", "logicalSpriteLocation", "sourceRole",
        "sourceAsset", "sourceAssetSha256", "authenticSpriteId",
        "customSpriteSubspace", "customSpriteEntry", "externalPng",
        "pictureMask", "blueMask"
      ],
      "properties": {
        "itemId": {"type": "integer", "minimum": 0, "maximum": 65535},
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "logicalSpriteLocation": {
          "anyOf": [
            {"type": "string", "minLength": 1, "maxLength": 512},
            {"type": "null"}
          ]
        },
        "sourceRole": {
          "enum": [
            "asset.sprite.authentic", "asset.sprite.custom",
            "asset.spritepack", "asset.sprite.external", "unresolved"
          ]
        },
        "sourceAsset": {"anyOf": [{"$ref": "#/$defs/portablePath"}, {"type": "null"}]},
        "sourceAssetSha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "authenticSpriteId": {
          "anyOf": [
            {"type": "integer", "minimum": 0, "maximum": 65535},
            {"type": "null"}
          ]
        },
        "customSpriteSubspace": {"anyOf": [{"$ref": "#/$defs/portablePath"}, {"type": "null"}]},
        "customSpriteEntry": {"anyOf": [{"$ref": "#/$defs/portablePath"}, {"type": "null"}]},
        "externalPng": {"anyOf": [{"$ref": "#/$defs/externalPng"}, {"type": "null"}]},
        "pictureMask": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
        "blueMask": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647}
      },
      "oneOf": [
        {
          "properties": {
            "sourceRole": {"const": "asset.sprite.authentic"},
            "logicalSpriteLocation": {"type": "string", "pattern": "^authentic/(?:0|[1-9][0-9]{0,4})$"},
            "sourceAsset": {"const": "assets/Authentic_Sprites.orsc"},
            "sourceAssetSha256": {"$ref": "#/$defs/sha256"},
            "authenticSpriteId": {"type": "integer", "minimum": 0, "maximum": 65535},
            "customSpriteSubspace": {"type": "null"},
            "customSpriteEntry": {"type": "null"},
            "externalPng": {"type": "null"}
          }
        },
        {
          "properties": {
            "sourceRole": {"const": "asset.sprite.custom"},
            "logicalSpriteLocation": {"type": "string", "pattern": "^custom/.+/.+$"},
            "sourceAsset": {"const": "assets/Custom_Sprites.osar"},
            "sourceAssetSha256": {"$ref": "#/$defs/sha256"},
            "authenticSpriteId": {"type": "null"},
            "customSpriteSubspace": {"$ref": "#/$defs/portablePath"},
            "customSpriteEntry": {"$ref": "#/$defs/portablePath"},
            "externalPng": {"type": "null"}
          }
        },
        {
          "properties": {
            "sourceRole": {"const": "asset.spritepack"},
            "logicalSpriteLocation": {"type": "string", "pattern": "^spritepack/.+/.+$"},
            "sourceAsset": {
              "allOf": [
                {"$ref": "#/$defs/portablePath"},
                {"type": "string", "pattern": "^assets/spritepacks/.+\\.osar$"}
              ]
            },
            "sourceAssetSha256": {"$ref": "#/$defs/sha256"},
            "authenticSpriteId": {"type": "null"},
            "customSpriteSubspace": {"$ref": "#/$defs/portablePath"},
            "customSpriteEntry": {"$ref": "#/$defs/portablePath"},
            "externalPng": {"type": "null"}
          }
        },
        {
          "properties": {
            "sourceRole": {"const": "asset.sprite.external"},
            "logicalSpriteLocation": {"type": "string", "pattern": "^external/assets/external-items/.+\\.[Pp][Nn][Gg]$"},
            "sourceAsset": {
              "allOf": [
                {"$ref": "#/$defs/portablePath"},
                {"type": "string", "pattern": "^assets/external-items/.+\\.[Pp][Nn][Gg]$"}
              ]
            },
            "sourceAssetSha256": {"$ref": "#/$defs/sha256"},
            "authenticSpriteId": {"type": "null"},
            "customSpriteSubspace": {"type": "null"},
            "customSpriteEntry": {"type": "null"},
            "externalPng": {"$ref": "#/$defs/externalPng"}
          }
        },
        {
          "properties": {
            "sourceRole": {"const": "unresolved"},
            "logicalSpriteLocation": {"type": "null"},
            "sourceAsset": {"type": "null"},
            "sourceAssetSha256": {"type": "null"},
            "authenticSpriteId": {"type": "null"},
            "customSpriteSubspace": {"type": "null"},
            "customSpriteEntry": {"type": "null"},
            "externalPng": {"type": "null"},
            "pictureMask": {"const": 0},
            "blueMask": {"const": 0}
          }
        }
      ]
    },
    "externalPng": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "sha256", "width", "height"],
      "properties": {
        "relativePath": {"$ref": "#/$defs/portablePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "width": {"type": "integer", "minimum": 1, "maximum": 4096},
        "height": {"type": "integer", "minimum": 1, "maximum": 4096}
      }
    }
  }
}
