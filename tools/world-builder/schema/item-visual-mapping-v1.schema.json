{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openrsc.com/world-builder/item-visual-mapping-v1.schema.json",
  "title": "World Builder item visual mapping input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifestType", "itemVisuals"],
  "properties": {
    "schemaVersion": {"const": 1},
    "manifestType": {"const": "world-builder-item-visual-mapping"},
    "itemVisuals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 65536,
      "items": {"$ref": "#/$defs/itemVisual"}
    }
  },
  "$defs": {
    "itemVisual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemId", "authenticSpriteId", "customSpriteAssetRole", "customSpriteSubspace", "customSpriteEntry", "pictureMask", "blueMask"],
      "properties": {
        "itemId": {"type": "integer", "minimum": 0, "maximum": 65535},
        "authenticSpriteId": {"type": ["integer", "null"], "minimum": 0, "maximum": 65535},
        "customSpriteAssetRole": {"enum": ["asset.sprite.custom", "asset.spritepack", null]},
        "customSpriteSubspace": {"type": ["string", "null"]},
        "customSpriteEntry": {"type": ["string", "null"]},
        "pictureMask": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
        "blueMask": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647}
      },
      "oneOf": [
        {
          "properties": {
            "authenticSpriteId": {"type": "integer"},
            "customSpriteAssetRole": {"type": "null"},
            "customSpriteSubspace": {"type": "null"},
            "customSpriteEntry": {"type": "null"}
          }
        },
        {
          "properties": {
            "authenticSpriteId": {"type": "null"},
            "customSpriteAssetRole": {"enum": ["asset.sprite.custom", "asset.spritepack"]},
            "customSpriteSubspace": {"type": "string", "minLength": 1},
            "customSpriteEntry": {"type": "string", "minLength": 1}
          }
        }
      ]
    }
  }
}
