{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsc-world-editor.invalid/world-builder/content-reconciliation-v1.schema.json",
  "title": "World Builder content reconciliation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "manifestType", "contentBundleFingerprintSha256",
    "outputPackageFingerprintSha256", "families", "modelArchive",
    "sceneryModels", "status", "issues", "reconciliationFingerprintSha256"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "manifestType": {"const": "world-builder-content-reconciliation"},
    "contentBundleFingerprintSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
    "outputPackageFingerprintSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
    "families": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/family"}, {"properties": {"family": {"const": "floor"}}}]},
        {"allOf": [{"$ref": "#/$defs/family"}, {"properties": {"family": {"const": "boundary"}}}]},
        {"allOf": [{"$ref": "#/$defs/family"}, {"properties": {"family": {"const": "ground-item"}}}]},
        {"allOf": [{"$ref": "#/$defs/family"}, {"properties": {"family": {"const": "npc"}}}]},
        {"allOf": [{"$ref": "#/$defs/family"}, {"properties": {"family": {"const": "scenery"}}}]}
      ],
      "items": false
    },
    "modelArchive": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "size", "sha256", "indexStatus", "entryCount"],
      "properties": {
        "role": {"const": "asset.model"},
        "size": {"$ref": "#/$defs/count"},
        "sha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
        "indexStatus": {"enum": ["indexed", "compressed-unverified", "malformed"]},
        "entryCount": {"type": "integer", "minimum": 0, "maximum": 8192}
      }
    },
    "sceneryModels": {
      "type": "array", "maxItems": 65536,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["sceneryId", "name", "modelName", "modelFileHash", "resolution"],
        "properties": {
          "sceneryId": {"$ref": "#/$defs/runtimeId"},
          "name": {"type": "string", "maxLength": 256},
          "modelName": {"type": "string", "maxLength": 256},
          "modelFileHash": {"type": "string", "pattern": "^([0-9a-f]{8})?$"},
          "resolution": {"enum": ["packaged-runtime", "project-archive", "generated-or-unspecified", "archive-unverified", "missing"]}
        }
      }
    },
    "status": {"enum": ["matched", "matched-with-warnings"]},
    "issues": {
      "type": "array", "maxItems": 4096,
      "items": {"$ref": "#/$defs/issue"}
    },
    "reconciliationFingerprintSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"}
  },
  "$defs": {
    "runtimeId": {"type": "integer", "minimum": 0, "maximum": 65535},
    "count": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "ids": {
      "type": "array", "maxItems": 65536, "uniqueItems": true,
      "items": {"$ref": "#/$defs/runtimeId"}
    },
    "role": {
      "enum": [
        "asset.library", "asset.model", "asset.sprite.authentic",
        "asset.sprite.custom", "asset.spritepack", "definition.boundary",
        "definition.item.base", "definition.item.custom", "definition.item.patch",
        "definition.item.world", "definition.npc.base", "definition.npc.custom",
        "definition.npc.patch", "definition.npc.world", "definition.scenery",
        "definition.tile"
      ]
    },
    "asset": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "size", "sha256"],
      "properties": {
        "role": {"$ref": "#/$defs/role"},
        "size": {"$ref": "#/$defs/count"},
        "sha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"}
      }
    },
    "family": {
      "type": "object", "additionalProperties": false,
      "required": [
        "family", "catalogDefinitionCount", "catalogDefinitionIdsSha256",
        "requiredPlacementDefinitionIds", "requiredPlacementDefinitionIdsSha256",
        "resolvedDefinitionCount", "resolvedDefinitionIdsSha256",
        "definitionRoles", "assets", "status"
      ],
      "properties": {
        "family": {"enum": ["floor", "boundary", "ground-item", "npc", "scenery"]},
        "catalogDefinitionCount": {"$ref": "#/$defs/count"},
        "catalogDefinitionIdsSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
        "requiredPlacementDefinitionIds": {"$ref": "#/$defs/ids"},
        "requiredPlacementDefinitionIdsSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
        "resolvedDefinitionCount": {"$ref": "#/$defs/count"},
        "resolvedDefinitionIdsSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
        "definitionRoles": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/role"}},
        "assets": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/asset"}},
        "status": {"const": "matched"}
      }
    },
    "issue": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "family", "definitionId", "assetRole", "message", "nextStep"],
      "properties": {
        "code": {"enum": ["MODEL_ARCHIVE_UNVERIFIED", "PACKAGED_SCENERY_BASELINE_UNVERIFIED", "SCENERY_DEFINITION_DETAILS_UNVERIFIED", "SCENERY_MODEL_MISSING", "SCENERY_MODEL_UNSPECIFIED"]},
        "family": {"const": "scenery"},
        "definitionId": {"type": "integer", "minimum": -1, "maximum": 65535},
        "assetRole": {"enum": ["asset.model", "definition.scenery"]},
        "message": {"type": "string", "minLength": 1, "maxLength": 2048},
        "nextStep": {"type": "string", "minLength": 1, "maxLength": 2048}
      }
    }
  }
}
