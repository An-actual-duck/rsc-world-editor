{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsc-world-editor.invalid/world-builder/current-runtime-upgrade-receipt-v1.schema.json",
  "title": "World Builder synthetic current-runtime upgrade receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "manifestType", "transactionId", "planFingerprintSha256",
    "status", "mutationOccurred", "rollbackComplete", "recoveryRequired",
    "preimageInventoryHash", "artifactPlanHash", "verificationEvidenceHash",
    "failureType", "receiptFingerprintSha256", "generatedStateOutputs", "runtimeExecutionOutputs"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "manifestType": {"const": "world-builder-current-runtime-upgrade-receipt"},
    "transactionId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
    "planFingerprintSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
    "status": {"enum": ["pending", "successful", "rolled-back", "recovery-required"]},
    "mutationOccurred": {"type": "boolean"},
    "rollbackComplete": {"type": "boolean"},
    "recoveryRequired": {"type": "boolean"},
    "preimageInventoryHash": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
    "artifactPlanHash": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
    "verificationEvidenceHash": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/optionalSha256"},
    "generatedStateOutputs": {"$ref": "#/$defs/generatedStateOutputs"},
    "runtimeExecutionOutputs": {"type":"array","maxItems":1,"items":{"$ref":"#/$defs/runtimeExecutionRecord"}},
    "runtimeVerificationAttempt": {"oneOf":[
      {"type":"object","additionalProperties":false,"required":[],"properties":{}},
      {"$ref":"#/$defs/runtimeVerificationAttempt"}
    ]},
    "failureType": {"type": "string", "maxLength": 1024},
    "receiptFingerprintSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"}
  },
  "$defs": {
    "runtimeVerificationAttempt": {
      "type":"object","additionalProperties":false,
      "required":["schemaVersion","attemptRoot","authoritySha256","invocationId","invocationSha256","options","retainedTools"],
      "properties": {
        "schemaVersion":{"const":1},
        "attemptRoot":{"$ref":"#/$defs/absolutePath"},
        "authoritySha256":{"$ref":"adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
        "invocationId":{"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
        "invocationSha256":{"$ref":"adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
        "options":{
          "type":"object","additionalProperties":false,
          "required":["client-profile","composition-identity","contract","installed-client-root","installed-server-root","map-package","runtime-profile","server-config","server-profile","state-db","workspace","server-port","websocket-port","evidence"],
          "properties":{
            "client-profile":{"$ref":"#/$defs/absolutePath"},"composition-identity":{"$ref":"#/$defs/absolutePath"},
            "contract":{"$ref":"#/$defs/absolutePath"},"installed-client-root":{"$ref":"#/$defs/absolutePath"},
            "installed-server-root":{"$ref":"#/$defs/absolutePath"},"map-package":{"$ref":"#/$defs/absolutePath"},
            "runtime-profile":{"$ref":"#/$defs/absolutePath"},"server-config":{"$ref":"#/$defs/absolutePath"},
            "server-profile":{"$ref":"#/$defs/absolutePath"},"state-db":{"$ref":"#/$defs/absolutePath"},
            "workspace":{"$ref":"#/$defs/absolutePath"},"evidence":{"$ref":"#/$defs/absolutePath"},
            "server-port":{"type":"string","pattern":"^[1-9][0-9]{0,4}$"},
            "websocket-port":{"type":"string","pattern":"^[1-9][0-9]{0,4}$"}
          }
        },
        "retainedTools":{
          "type":"array","minItems":2,"maxItems":2,"items":{"$ref":"#/$defs/retainedTool"},
          "prefixItems":[
            {"allOf":[{"$ref":"#/$defs/retainedTool"},{"properties":{"relativePath":{"const":"provider-tools/core.jar"}}}]},
            {"allOf":[{"$ref":"#/$defs/retainedTool"},{"properties":{"relativePath":{"const":"provider-tools/contract.json"},"size":{"maximum":65536},"sha256":{"const":"227abec8c5180b80a504591083c2d4d000152d2047dba5fa27202cdce56659da"}}}]}
          ]
        }
      }
    },
    "absolutePath":{"type":"string","minLength":1,"maxLength":4096,"pattern":"^/"},
    "retainedTool":{
      "type":"object","additionalProperties":false,"required":["relativePath","size","sha256","mode"],
      "properties":{
        "relativePath":{"enum":["provider-tools/core.jar","provider-tools/contract.json"]},
        "size":{"type":"integer","minimum":1,"maximum":268435456},
        "sha256":{"$ref":"adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},"mode":{"const":"0600"}
      }
    },
    "runtimeExecutionRecord": {
      "type":"object","additionalProperties":false,
      "required":["relativePath","size","sha256","mode","verifierContractSha256"],
      "properties":{
        "relativePath":{"const":"migration/output/verification/installed-execution-evidence.json"},
        "size":{"type":"integer","minimum":1,"maximum":1048576},
        "sha256":{"$ref":"adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
        "mode":{"const":"0600"},
        "verifierContractSha256":{"const":"227abec8c5180b80a504591083c2d4d000152d2047dba5fa27202cdce56659da"}
      }
    },
    "generatedStateOutputs": {
      "type": "array", "minItems": 0, "maxItems": 2,
      "oneOf": [{"maxItems": 0}, {"minItems": 2}],
      "items": {"$ref": "#/$defs/generatedStateRecord"},
      "prefixItems": [
        {"properties": {"relativePath": {"const": "migration/output/state/current-base-migration-evidence.json"}, "size": {"maximum": 1048576}}},
        {"properties": {"relativePath": {"const": "migration/output/state/current-base.db"}, "size": {"maximum": 1073741824}}}
      ]
    },
    "generatedStateRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["relativePath", "size", "sha256", "mode"],
      "properties": {
        "relativePath": {"type": "string"},
        "size": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
        "mode": {"const": "0600"}
      }
    }
  }
}
