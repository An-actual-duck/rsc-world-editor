{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsc-world-editor.invalid/world-builder/current-runtime-upgrade-receipt-v1.schema.json",
  "title": "World Builder synthetic current-runtime upgrade receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "manifestType", "transactionId", "planFingerprintSha256",
    "status", "mutationOccurred", "rollbackComplete", "recoveryRequired",
    "preimageInventoryHash", "artifactPlanHash", "verificationEvidenceHash",
    "failureType", "receiptFingerprintSha256", "generatedStateOutputs"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "manifestType": {"const": "world-builder-current-runtime-upgrade-receipt"},
    "transactionId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
    "planFingerprintSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
    "status": {"enum": ["pending", "successful", "rolled-back", "recovery-required"]},
    "mutationOccurred": {"type": "boolean"},
    "rollbackComplete": {"type": "boolean"},
    "recoveryRequired": {"type": "boolean"},
    "preimageInventoryHash": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
    "artifactPlanHash": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
    "verificationEvidenceHash": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/optionalSha256"},
    "generatedStateOutputs": {"$ref": "#/$defs/generatedStateOutputs"},
    "failureType": {"type": "string", "maxLength": 1024},
    "receiptFingerprintSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"}
  },
  "$defs": {
    "generatedStateOutputs": {
      "type": "array", "minItems": 0, "maxItems": 2,
      "oneOf": [{"maxItems": 0}, {"minItems": 2}],
      "items": {"$ref": "#/$defs/generatedStateRecord"},
      "prefixItems": [
        {"properties": {"relativePath": {"const": "migration/output/state/current-base-migration-evidence.json"}, "size": {"maximum": 1048576}}},
        {"properties": {"relativePath": {"const": "migration/output/state/current-base.db"}, "size": {"maximum": 1073741824}}}
      ]
    },
    "generatedStateRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["relativePath", "size", "sha256", "mode"],
      "properties": {
        "relativePath": {"type": "string"},
        "size": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
        "mode": {"const": "0600"}
      }
    }
  }
}
