{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsc-world-editor.invalid/world-builder/project-content-bundle-v3.schema.json",
  "title": "World Builder project-local custom content bundle v3",
  "$comment": "Executable validation is authoritative for canonical ordering, exact role/path mapping, archive closure, and fingerprints.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "manifestType", "capabilityId", "sourceKind",
    "definitionCatalog", "familyBindings", "itemVisuals", "files",
    "definitionFingerprintSha256", "assetFingerprintSha256",
    "itemVisualFingerprintSha256", "bundleFingerprintSha256"
  ],
  "properties": {
    "schemaVersion": {"const": 3},
    "manifestType": {"const": "world-builder-project-content-bundle"},
    "capabilityId": {"const": "project-local-custom-content-v3"},
    "sourceKind": {"enum": ["content-neutral-default", "target-adopted"]},
    "definitionCatalog": {"$ref": "project-content-bundle-v2.schema.json#/$defs/definitionCatalog"},
    "familyBindings": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {"$ref": "project-content-bundle-v2.schema.json#/$defs/familyBinding"}
    },
    "itemVisuals": {
      "type": "array", "maxItems": 65536,
      "items": {"$ref": "project-content-bundle-v2.schema.json#/$defs/itemVisual"}
    },
    "files": {
      "type": "array", "minItems": 18, "maxItems": 18,
      "items": {"$ref": "#/$defs/file"}
    },
    "definitionFingerprintSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
    "assetFingerprintSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
    "itemVisualFingerprintSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
    "bundleFingerprintSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"}
  },
  "$defs": {
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "bundleRelativePath", "runtimeRelativePath", "mediaType", "size", "sha256"],
      "properties": {
        "role": {
          "anyOf": [
            {"$ref": "project-content-bundle-v2.schema.json#/$defs/definitionRole"},
            {"$ref": "project-content-bundle-v2.schema.json#/$defs/assetRole"},
            {"enum": ["metadata.item-visuals", "metadata.npc-animations"]}
          ]
        },
        "bundleRelativePath": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/relativePath"},
        "runtimeRelativePath": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/relativePath"},
        "mediaType": {"enum": ["application/gzip", "application/json", "application/vnd.openrsc.archive", "application/xml"]},
        "size": {"type": "integer", "minimum": 1, "maximum": 268435456},
        "sha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"}
      }
    }
  }
}
