{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsc-world-editor.invalid/world-builder/region-selection-v1.schema.json",
  "title": "World Builder ordered region selection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifestType", "worldSpace", "markers", "levels", "selectionFingerprintSha256"],
  "properties": {
    "schemaVersion": {"const": 1},
    "manifestType": {"const": "world-builder-region-selection"},
    "worldSpace": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
    "markers": {
      "type": "array", "minItems": 3, "maxItems": 256,
      "items": {"$ref": "#/$defs/marker"}
    },
    "levels": {
      "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
      "items": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647}
    },
    "selectionFingerprintSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"}
  },
  "$defs": {
    "marker": {
      "type": "object", "additionalProperties": false,
      "required": ["marker", "x", "y"],
      "properties": {
        "marker": {"type": "integer", "minimum": 1, "maximum": 256},
        "x": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
        "y": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647}
      }
    }
  }
}
