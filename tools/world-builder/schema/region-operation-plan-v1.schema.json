{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsc-world-editor.invalid/world-builder/region-operation-plan-v1.schema.json",
  "title": "World Builder atomic region operation plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifestType", "operation", "snapshotId", "projectId", "workingBeforeSha256", "destinationAnchor", "files", "placementIdMappings", "collisions", "overwriteRequired", "blocked", "planFingerprintSha256"],
  "properties": {
    "schemaVersion": {"const": 1},
    "manifestType": {"const": "world-builder-region-operation-plan"},
    "operation": {"enum": ["cut", "paste"]},
    "snapshotId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
    "projectId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/uuid"},
    "workingBeforeSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
    "destinationAnchor": {"$ref": "#/$defs/point3"},
    "files": {
      "type": "array", "maxItems": 1024,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["relativePath", "beforeSha256", "afterSha256"],
        "properties": {
          "relativePath": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/relativePath"},
          "beforeSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
          "afterSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"}
        }
      }
    },
    "placementIdMappings": {
      "type": "array", "maxItems": 65536,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["family", "sourcePlacementId", "destinationPlacementId"],
        "properties": {
          "family": {"enum": ["boundary", "ground-item", "npc", "scenery"]},
          "sourcePlacementId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
          "destinationPlacementId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"}
        }
      }
    },
    "collisions": {
      "type": "array", "maxItems": 65536,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "level", "x", "y", "detail"],
        "properties": {
          "kind": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
          "level": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
          "x": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
          "y": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
          "detail": {"type": "string", "minLength": 1, "maxLength": 256}
        }
      }
    },
    "overwriteRequired": {"type": "boolean"},
    "blocked": {"type": "boolean"},
    "planFingerprintSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"}
  },
  "$defs": {
    "point3": {
      "type": "object", "additionalProperties": false,
      "required": ["level", "x", "y"],
      "properties": {
        "level": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
        "x": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
        "y": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647}
      }
    }
  }
}
