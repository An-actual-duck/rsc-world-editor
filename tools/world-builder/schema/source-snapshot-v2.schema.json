{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsc-world-editor.invalid/world-builder/source-snapshot-v2.schema.json",
  "title": "World Builder immutable source snapshot v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "manifestType", "projectId", "origin", "adapterId",
    "capabilityId", "selectedConfiguration", "discoveryReport", "originDescriptor",
    "originalFiles", "definitionRuntimeFiles", "conversionEvidenceFiles",
    "layeredBaselineFiles", "sourceFingerprintSha256"
  ],
  "properties": {
    "schemaVersion": {"const": 2},
    "manifestType": {"const": "world-builder-source-snapshot"},
    "projectId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/uuid"},
    "origin": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/origin"},
    "adapterId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/optionalIdentifier"},
    "capabilityId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/optionalIdentifier"},
    "selectedConfiguration": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/roleStateReference"},
    "discoveryReport": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/stateReference"},
    "originDescriptor": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/stateReference"},
    "originalFiles": {"$ref": "#/$defs/nonemptyInventory"},
    "definitionRuntimeFiles": {"$ref": "#/$defs/nonemptyInventory"},
    "conversionEvidenceFiles": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/inventory"},
    "layeredBaselineFiles": {"$ref": "#/$defs/nonemptyInventory"},
    "sourceFingerprintSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"origin": {"const": "target-packed"}}},
      "then": {
        "properties": {
          "conversionEvidenceFiles": {
            "minItems": 2,
            "maxItems": 2,
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "role": {"const": "conversion-plan"},
                    "relativePath": {"const": "source/conversion/plan.json"},
                    "present": {"const": true}
                  },
                  "required": ["role", "relativePath", "present"]
                }
              },
              {
                "contains": {
                  "properties": {
                    "role": {"const": "conversion-report"},
                    "relativePath": {"const": "source/conversion/report.json"},
                    "present": {"const": true}
                  },
                  "required": ["role", "relativePath", "present"]
                }
              }
            ]
          }
        }
      },
      "else": {"properties": {"conversionEvidenceFiles": {"maxItems": 0}}}
    }
  ],
  "$defs": {
    "nonemptyInventory": {
      "type": "array", "minItems": 1, "maxItems": 8192,
      "items": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/inventoryRecord"}
    }
  }
}
