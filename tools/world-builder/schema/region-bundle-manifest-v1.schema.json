{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsc-world-editor.invalid/world-builder/region-bundle-manifest-v1.schema.json",
  "title": "World Builder portable region bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifestType", "formatId", "snapshotId", "files", "bundleFingerprintSha256"],
  "properties": {
    "schemaVersion": {"const": 1},
    "manifestType": {"const": "world-builder-region-bundle"},
    "formatId": {"const": "portable-region-bundle-v1"},
    "snapshotId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
    "files": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "relativePath", "size", "sha256"],
        "properties": {
          "role": {"const": "snapshot"},
          "relativePath": {"const": "snapshot.json"},
          "size": {"type": "integer", "minimum": 2, "maximum": 16777216},
          "sha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"}
        }
      }
    },
    "bundleFingerprintSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"}
  }
}
