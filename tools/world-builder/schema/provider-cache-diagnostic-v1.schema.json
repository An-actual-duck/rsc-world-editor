{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsc-world-editor.invalid/world-builder/provider-cache-diagnostic-v1.schema.json",
  "title": "World Builder portable provider-cache diagnostic v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "manifestType", "sourceDiscoveryFingerprintSha256",
    "status", "cacheStatus", "summary", "candidateProfiles",
    "sourcePathsIncluded"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "manifestType": {"const": "world-builder-provider-cache-diagnostic"},
    "sourceDiscoveryFingerprintSha256": {
      "type": "string", "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": ["explicit", "recognized", "local", "ambiguous", "stale", "corrupt", "none"]
    },
    "cacheStatus": {
      "enum": ["bypassed", "hit", "miss", "stale", "corrupt", "ambiguous"]
    },
    "summary": {"type": "string", "minLength": 1, "maxLength": 2048},
    "candidateProfiles": {
      "type": "array", "maxItems": 32768,
      "items": {"$ref": "#/$defs/profile"}
    },
    "sourcePathsIncluded": {"const": false}
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "label", "componentRoles"],
      "properties": {
        "profileId": {"type": "string", "minLength": 1, "maxLength": 256},
        "label": {"type": "string", "minLength": 1, "maxLength": 512},
        "componentRoles": {
          "type": "array", "maxItems": 6, "uniqueItems": true,
          "items": {
            "enum": [
              "item-visuals", "definitions", "authentic-archive",
              "custom-archive", "spritepacks", "external-items"
            ]
          }
        }
      }
    }
  }
}
