{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsc-world-editor.invalid/world-builder/current-input-adapter-v1.schema.json",
  "title": "World Builder current-generation input adapter v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "manifestType", "adapterId", "adapterVersion",
    "historicalRuntimeId", "evidenceAuthority", "installable",
    "recommendedVariantId", "supportedManagedPredecessorReleaseIds",
    "targetLedgerRelativePath",
    "probeRoots", "evidenceRules", "adapterManifestHash"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "manifestType": {"const": "world-builder-input-adapter-v1"},
    "adapterId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
    "adapterVersion": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
    "historicalRuntimeId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
    "evidenceAuthority": {"enum": ["production-reviewed", "synthetic-fixture"]},
    "installable": {"const": false},
    "recommendedVariantId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
    "supportedManagedPredecessorReleaseIds": {
      "type": "array", "maxItems": 64, "uniqueItems": true,
      "items": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"}
    },
    "targetLedgerRelativePath": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/relativePath"},
    "probeRoots": {
      "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
      "items": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/relativePath"}
    },
    "evidenceRules": {
      "type": "array", "minItems": 1, "maxItems": 4096,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "role", "relativePath", "required", "baselineSize", "baselineSha256",
          "evidenceKind", "recognizedDeltas"
        ],
        "properties": {
          "role": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
          "relativePath": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/relativePath"},
          "required": {"type": "boolean"},
          "baselineSize": {"type": "integer", "minimum": 0, "maximum": 4294967296},
          "baselineSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/optionalSha256"},
          "evidenceKind": {
            "enum": [
              "configuration", "database", "generated-state", "portable-data",
              "map", "plugin-source", "core-source", "client-source", "build",
              "definition", "asset", "dependency", "executable"
            ]
          },
          "recognizedDeltas": {
            "type": "array", "maxItems": 64,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": [
                "size", "sha256", "tier", "disposition", "moduleId", "reason"
              ],
              "properties": {
                "size": {"type": "integer", "minimum": 0, "maximum": 4294967296},
                "sha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
                "tier": {"enum": ["T1", "T2A", "T2B", "T3", "T4"]},
                "disposition": {
                  "enum": [
                    "preserve-state", "typed-configuration", "canonical-data",
                    "canonical-map", "mapped-to-platform", "mapped-to-module",
                    "retire", "discard-generated", "port-required"
                  ]
                },
                "moduleId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/optionalIdentifier"},
                "reason": {"type": "string", "minLength": 1, "maxLength": 1024}
              }
            }
          }
        }
      }
    },
    "adapterManifestHash": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"}
  }
}
