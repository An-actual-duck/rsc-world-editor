{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsc-world-editor.invalid/world-builder/map-migration-choice-v1.schema.json",
  "title": "World Builder map migration choice v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "manifestType", "toolVersion", "decision",
    "selectedTargetDiscoveryFingerprintSha256",
    "legacyPackedDiscoveryFingerprintSha256", "selectedConfiguration",
    "legacyConfiguration", "legacyTerrain", "retirementRequested",
    "migrationChoiceFingerprintSha256"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "manifestType": {"const": "world-builder-map-migration-choice"},
    "toolVersion": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
    "decision": {
      "enum": [
        "incorporate-legacy-landscape",
        "keep-selected-layered-landscape"
      ]
    },
    "selectedTargetDiscoveryFingerprintSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
    "legacyPackedDiscoveryFingerprintSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
    "selectedConfiguration": {
      "allOf": [
        {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/roleStateReference"},
        {"properties": {"present": {"const": true}}}
      ]
    },
    "legacyConfiguration": {
      "allOf": [
        {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/roleStateReference"},
        {"properties": {"present": {"const": true}}}
      ]
    },
    "legacyTerrain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["server", "client", "byteIdentical"],
      "properties": {
        "server": {
          "allOf": [
            {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/inventoryRecord"},
            {"properties": {"role": {"const": "server-terrain"}, "present": {"const": true}}}
          ]
        },
        "client": {
          "allOf": [
            {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/inventoryRecord"},
            {"properties": {"role": {"const": "client-terrain"}, "present": {"const": true}}}
          ]
        },
        "byteIdentical": {"const": true}
      }
    },
    "retirementRequested": {"type": "boolean"},
    "migrationChoiceFingerprintSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"}
  }
}
