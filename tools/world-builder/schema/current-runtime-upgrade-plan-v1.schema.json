{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsc-world-editor.invalid/world-builder/current-runtime-upgrade-plan-v1.schema.json",
  "title": "World Builder synthetic current-runtime upgrade plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "manifestType", "transactionId", "classificationStatus",
    "classificationTier", "classificationFingerprintSha256", "inputAdapter",
    "projectCapability", "destination", "preimageInventory",
    "preimageInventoryHash", "semanticActions", "semanticActionsHash",
    "artifactPlan", "artifactPlanHash", "releaseRelativePath", "stagingPolicy",
    "activationLedgerRelativePath", "activationLedger",
    "verificationEvidenceHash", "mapImportAvailableBeforeApply",
    "mutationOccurred", "confirmationIdentity", "planFingerprintSha256"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "manifestType": {"const": "world-builder-current-runtime-upgrade-plan"},
    "transactionId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
    "classificationStatus": {"const": "UPGRADE_READY"},
    "classificationTier": {"enum": ["T0", "T1", "T2A", "T2B", "MANAGED_N"]},
    "classificationFingerprintSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
    "inputAdapter": {
      "type": "object", "additionalProperties": false,
      "required": ["adapterId", "adapterManifestHash", "inputAdapterContractId", "evidenceAuthority"],
      "properties": {
        "adapterId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
        "adapterManifestHash": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
        "inputAdapterContractId": {"const": "world-builder-input-adapter-v1"},
        "evidenceAuthority": {"const": "synthetic-fixture"}
      }
    },
    "projectCapability": {
      "type": "object", "additionalProperties": false,
      "required": ["projectId", "capabilityFingerprintSha256"],
      "properties": {
        "projectId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/uuid"},
        "capabilityFingerprintSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"}
      }
    },
    "destination": {"$ref": "current-target-classification-v1.schema.json#/$defs/runtimeIdentity"},
    "preimageInventory": {
      "type": "array", "minItems": 1, "maxItems": 8192,
      "items": {"$ref": "#/$defs/preimage"}
    },
    "preimageInventoryHash": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
    "semanticActions": {
      "type": "array", "minItems": 1, "maxItems": 8192,
      "items": {"$ref": "#/$defs/semanticAction"}
    },
    "semanticActionsHash": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
    "artifactPlan": {
      "type": "array", "minItems": 1, "maxItems": 8192,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "artifactPlanHash": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
    "releaseRelativePath": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/relativePath"},
    "stagingPolicy": {"const": "external-same-filesystem-outside-active-target"},
    "activationLedgerRelativePath": {"const": ".world-builder/runtime-ledger-v1.json"},
    "activationLedger": {"$ref": "current-target-runtime-ledger-v1.schema.json"},
    "verificationEvidenceHash": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
    "mapImportAvailableBeforeApply": {"const": false},
    "mutationOccurred": {"const": false},
    "confirmationIdentity": {"type": "string", "pattern": "^UPGRADE:[A-Za-z0-9._-]+:[0-9a-f]{64}:[0-9a-f]{64}$", "maxLength": 512},
    "planFingerprintSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"}
  },
  "$defs": {
    "preimage": {
      "type": "object", "additionalProperties": false,
      "required": ["relativePath", "present", "size", "sha256", "backupRelativePath"],
      "properties": {
        "relativePath": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/relativePath"},
        "present": {"type": "boolean"},
        "size": {"type": "integer", "minimum": 0, "maximum": 4294967296},
        "sha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/optionalSha256"},
        "backupRelativePath": {"type": "string", "maxLength": 4096}
      }
    },
    "semanticAction": {
      "type": "object", "additionalProperties": false,
      "required": ["relativePath", "tier", "disposition", "moduleId", "sourceSha256", "execution"],
      "properties": {
        "relativePath": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/relativePath"},
        "tier": {"enum": ["T0", "T1", "T2A", "T2B", "MANAGED_N"]},
        "disposition": {"type": "string", "minLength": 1, "maxLength": 128},
        "moduleId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/optionalIdentifier"},
        "sourceSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/optionalSha256"},
        "execution": {"enum": ["preserve-preimage-and-activate-independent-current-bundle", "advance-side-by-side-composition-and-activate-last"]}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["sourcePath", "bundlePath", "installRelativePath", "mode", "size", "sha256"],
      "properties": {
        "sourcePath": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/relativePath"},
        "bundlePath": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/relativePath"},
        "installRelativePath": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/relativePath"},
        "mode": {"type": "string", "pattern": "^[0-7]{4}$"},
        "size": {"type": "integer", "minimum": 0, "maximum": 4294967296},
        "sha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"}
      }
    }
  }
}
