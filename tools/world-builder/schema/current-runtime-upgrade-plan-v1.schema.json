{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsc-world-editor.invalid/world-builder/current-runtime-upgrade-plan-v1.schema.json",
  "title": "World Builder current-runtime upgrade plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "manifestType", "transactionId", "classificationStatus",
    "classificationTier", "classificationFingerprintSha256", "inputAdapter",
    "executionProfile", "migrationPlan",
    "projectCapability", "destination", "preimageInventory",
    "preimageInventoryHash", "semanticActions", "semanticActionsHash",
    "artifactPlan", "artifactPlanHash", "releaseRelativePath", "stagingPolicy",
    "activationLedgerRelativePath", "activationLedger",
    "verificationEvidenceHash", "mapImportAvailableBeforeApply",
    "mutationOccurred", "activationAuthorized", "confirmationIdentity", "planFingerprintSha256"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "manifestType": {"const": "world-builder-current-runtime-upgrade-plan"},
    "transactionId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
    "classificationStatus": {"enum": ["UPGRADE_READY", "NOT_INSTALLABLE"]},
    "classificationTier": {"enum": ["T0", "T1", "T2A", "T2B", "MANAGED_N"]},
    "classificationFingerprintSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
    "inputAdapter": {
      "type": "object", "additionalProperties": false,
      "required": ["adapterId", "adapterManifestHash", "inputAdapterContractId", "evidenceAuthority"],
      "properties": {
        "adapterId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
        "adapterManifestHash": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
        "inputAdapterContractId": {"const": "world-builder-input-adapter-v1"},
        "evidenceAuthority": {"enum": ["synthetic-fixture", "production-reviewed"]}
      }
    },
    "executionProfile": {"$ref": "#/$defs/executionProfile"},
    "migrationPlan": {"$ref": "#/$defs/migrationPlan"},
    "projectCapability": {
      "type": "object", "additionalProperties": false,
      "required": ["projectId", "capabilityFingerprintSha256"],
      "properties": {
        "projectId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/uuid"},
        "capabilityFingerprintSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"}
      }
    },
    "destination": {"$ref": "current-target-classification-v1.schema.json#/$defs/runtimeIdentity"},
    "preimageInventory": {
      "type": "array", "minItems": 1, "maxItems": 8192,
      "items": {"$ref": "#/$defs/preimage"}
    },
    "preimageInventoryHash": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
    "semanticActions": {
      "type": "array", "minItems": 1, "maxItems": 8192,
      "items": {"$ref": "#/$defs/semanticAction"}
    },
    "semanticActionsHash": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
    "artifactPlan": {
      "type": "array", "minItems": 1, "maxItems": 8192,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "artifactPlanHash": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
    "releaseRelativePath": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/relativePath"},
    "stagingPolicy": {"const": "external-same-filesystem-outside-active-target"},
    "activationLedgerRelativePath": {"const": ".world-builder/runtime-ledger-v1.json"},
    "activationLedger": {"$ref": "current-target-runtime-ledger-v1.schema.json"},
    "verificationEvidenceHash": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
    "mapImportAvailableBeforeApply": {"const": false},
    "mutationOccurred": {"const": false},
    "activationAuthorized": {"type": "boolean"},
    "confirmationIdentity": {"type": "string", "pattern": "^UPGRADE:[A-Za-z0-9._-]+:[0-9a-f]{64}:[0-9a-f]{64}$", "maxLength": 512},
    "planFingerprintSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"classificationStatus": {"const": "NOT_INSTALLABLE"}}},
      "then": {"properties": {"activationAuthorized": {"const": false}}}
    },
    {
      "if": {"properties": {"executionProfile": {"properties": {"executionReady": {"const": false}}}}},
      "then": {"properties": {"activationAuthorized": {"const": false}}}
    }
  ],
  "$defs": {
    "executionProfile": {
      "type": "object", "additionalProperties": false,
      "required": ["profileId", "migratorId", "serverBuildId", "clientBuildId",
        "mapPackageId", "configurationMigrationId", "stateMigrationId",
        "mapMigrationId", "activationManifestType", "syntheticOnly",
        "executionReady", "executionReadinessStatus", "executionReadinessReason",
        "executionReadinessConditions"],
      "properties": {
        "profileId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
        "migratorId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
        "serverBuildId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
        "clientBuildId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
        "mapPackageId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
        "configurationMigrationId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
        "stateMigrationId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
        "mapMigrationId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
        "activationManifestType": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
        "syntheticOnly": {"type": "boolean"},
        "executionReady": {"type": "boolean"},
        "executionReadinessStatus": {"enum": ["synthetic-regression-ready", "migration-and-verification-not-implemented"]},
        "executionReadinessReason": {"type": "string", "minLength": 1, "maxLength": 1024},
        "executionReadinessConditions": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["conditionId", "ready"],
            "properties": {
              "conditionId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
              "ready": {"type": "boolean"}
            }
          }
        }
      }
    },
    "migrationPlan": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "manifestType", "migratorId",
        "configurationMigrationId", "typedConfiguration", "durableStateMigrationId",
        "durableState", "mapMigration", "stagedExecution", "migrationPlanFingerprintSha256"],
      "properties": {
        "schemaVersion": {"const": 1},
        "manifestType": {"const": "world-builder-current-runtime-migration-plan"},
        "migratorId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
        "configurationMigrationId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
        "typedConfiguration": {"type": "object"},
        "durableStateMigrationId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
        "durableState": {"type": "array", "maxItems": 8192, "items": {"type": "object"}},
        "mapMigration": {"type": "object"},
        "stagedExecution": {
          "type": "object", "additionalProperties": false,
          "required": ["implementationId", "stagedOutputs", "readinessBlockers"],
          "properties": {
            "implementationId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
            "requiredStateMigrationContractId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
            "requiredStateMigrationRowId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
            "requiredProviderArtifactRoles": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"}},
            "providerStateMigration": {"$ref": "#/$defs/providerStateMigration"},
            "typedConfigurationReady": {"type": "boolean"},
            "sqliteSnapshotReady": {"type": "boolean"},
            "sqliteSchemaMigrationReady": {"type": "boolean"},
            "mariaDbMigrationReady": {"type": "boolean"},
            "canonicalMapPackageReady": {"type": "boolean"},
            "stagedOutputs": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/migrationOutput"}},
            "readinessBlockers": {"type": "array", "maxItems": 32, "items": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"}}
          }
        },
        "migrationPlanFingerprintSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"}
      }
    },
    "migrationOutput": {
      "type": "object", "additionalProperties": false,
      "required": ["relativePath", "kind", "sourceRelativePath", "sourceSha256", "size", "sha256", "mode"],
      "properties": {
        "relativePath": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/relativePath"},
        "kind": {"const": "typed-configuration"},
        "sourceRelativePath": {"type": "string", "maxLength": 4096},
        "sourceSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/optionalSha256"},
        "size": {"type": "integer", "minimum": 0, "maximum": 4294967296},
        "sha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
        "mode": {"const": "0600"}
      }
    },
    "providerStateMigration": {
      "type": "object", "additionalProperties": false,
      "required": ["contractBundlePath", "contractSha256", "toolBundlePath",
        "toolSha256", "toolArtifactRole", "mainClass", "migrationRowId", "engine",
        "sourceRelativePath", "sourceSha256", "stageRelativePath",
        "evidenceRelativePath", "evidenceSchemaId", "host", "port",
        "sourceSchema", "stageSchema", "userEnvironmentName",
        "passwordEnvironmentName"],
      "properties": {
        "contractBundlePath": {"const": "contracts/runtime/current-base-v1/state-migration.json"},
        "contractSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
        "toolBundlePath": {"const": "runtime/server/core.jar"},
        "toolSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
        "toolArtifactRole": {"const": "server-runtime"},
        "mainClass": {"const": "com.openrsc.server.database.CurrentBaseStateMigration"},
        "migrationRowId": {"const": "preservation-retro-to-current-base-v1"},
        "engine": {"enum": ["sqlite", "mariadb"]},
        "sourceRelativePath": {"type": "string", "maxLength": 4096},
        "sourceSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/optionalSha256"},
        "stageRelativePath": {"type": "string", "maxLength": 4096},
        "evidenceRelativePath": {"const": "migration/output/state/current-base-migration-evidence.json"},
        "evidenceSchemaId": {"const": "current-base-state-migration-evidence-v1"},
        "host": {"type": "string", "maxLength": 64},
        "port": {"type": "integer", "minimum": 0, "maximum": 65535},
        "sourceSchema": {"type": "string", "maxLength": 64},
        "stageSchema": {"type": "string", "maxLength": 64},
        "userEnvironmentName": {"type": "string", "maxLength": 128},
        "passwordEnvironmentName": {"type": "string", "maxLength": 128}
      }
    },
    "preimage": {
      "type": "object", "additionalProperties": false,
      "required": ["relativePath", "present", "size", "sha256", "backupRelativePath"],
      "properties": {
        "relativePath": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/relativePath"},
        "present": {"type": "boolean"},
        "size": {"type": "integer", "minimum": 0, "maximum": 4294967296},
        "sha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/optionalSha256"},
        "backupRelativePath": {"type": "string", "maxLength": 4096}
      }
    },
    "semanticAction": {
      "type": "object", "additionalProperties": false,
      "required": ["relativePath", "tier", "disposition", "moduleId", "sourceSha256", "execution"],
      "properties": {
        "relativePath": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/relativePath"},
        "tier": {"enum": ["T0", "T1", "T2A", "T2B", "MANAGED_N"]},
        "disposition": {"type": "string", "minLength": 1, "maxLength": 128},
        "moduleId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/optionalIdentifier"},
        "sourceSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/optionalSha256"},
        "execution": {"enum": ["preserve-preimage-and-activate-independent-current-bundle", "advance-side-by-side-composition-and-activate-last"]}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["sourcePath", "bundlePath", "installRelativePath", "mode", "size", "sha256"],
      "properties": {
        "sourcePath": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/relativePath"},
        "bundlePath": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/relativePath"},
        "installRelativePath": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/relativePath"},
        "mode": {"type": "string", "pattern": "^[0-7]{4}$"},
        "size": {"type": "integer", "minimum": 0, "maximum": 4294967296},
        "sha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"}
      }
    }
  }
}
