{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsc-world-editor.invalid/world-builder/current-runtime-variant-v1.schema.json",
  "title": "World Builder current runtime variant v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "manifestType", "variantId", "variantKind",
    "platformReleaseId", "platformManifestHash", "defaultModuleIds",
    "allowedModuleIds", "semanticContractIds", "advancedOnly",
    "variantManifestHash"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "manifestType": {"const": "world-builder-current-runtime-variant"},
    "variantId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
    "variantKind": {"enum": ["base", "advanced"]},
    "platformReleaseId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
    "platformManifestHash": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
    "defaultModuleIds": {"$ref": "#/$defs/identifiers"},
    "allowedModuleIds": {"$ref": "#/$defs/identifiers"},
    "semanticContractIds": {"$ref": "#/$defs/nonemptyIdentifiers"},
    "advancedOnly": {"type": "boolean"},
    "variantManifestHash": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"}
  },
  "$defs": {
    "identifiers": {
      "type": "array", "maxItems": 128, "uniqueItems": true,
      "items": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"}
    },
    "nonemptyIdentifiers": {
      "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true,
      "items": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"}
    }
  }
}
