{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsc-world-editor.invalid/world-builder/current-platform-release-v1.schema.json",
  "title": "World Builder current platform release v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "manifestType", "strategyId", "platformReleaseId",
    "platformApiVersion", "protocolId", "stateSchemaId",
    "supportedPredecessorReleaseIds", "variants", "inputAdapters",
    "platformManifestHash"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "manifestType": {"const": "world-builder-current-platform-release"},
    "strategyId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
    "platformReleaseId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
    "platformApiVersion": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
    "protocolId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
    "stateSchemaId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
    "supportedPredecessorReleaseIds": {
      "type": "array", "maxItems": 64, "uniqueItems": true,
      "items": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"}
    },
    "variants": {"$ref": "#/$defs/identifiers"},
    "inputAdapters": {"$ref": "#/$defs/identifiers"},
    "platformManifestHash": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"}
  },
  "$defs": {
    "identifiers": {
      "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
      "items": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"}
    }
  }
}
