{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsc-world-editor.invalid/world-builder/current-project-capability-v1.schema.json",
  "title": "World Builder durable current project capability v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "manifestType", "projectId", "projectSchemaId",
    "projectSchemaHash", "authoredDataFingerprintSha256", "allowedVariantIds",
    "requiredCapabilityIds", "requiredModuleIds", "capabilityFingerprintSha256"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "manifestType": {"const": "world-builder-current-project-capability"},
    "projectId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/uuid"},
    "projectSchemaId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
    "projectSchemaHash": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
    "authoredDataFingerprintSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
    "allowedVariantIds": {"$ref": "#/$defs/nonemptyIdentifiers"},
    "requiredCapabilityIds": {"$ref": "#/$defs/identifiers"},
    "requiredModuleIds": {"$ref": "#/$defs/identifiers"},
    "capabilityFingerprintSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"}
  },
  "$defs": {
    "identifiers": {
      "type": "array", "maxItems": 128, "uniqueItems": true,
      "items": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"}
    },
    "nonemptyIdentifiers": {
      "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true,
      "items": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"}
    }
  }
}
