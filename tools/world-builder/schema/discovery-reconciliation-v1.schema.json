{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsc-world-editor.invalid/world-builder/discovery-reconciliation-v1.schema.json",
  "title": "World Builder discovery reconciliation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "manifestType", "adapterId", "representation",
    "sourceFingerprintSha256", "outputPackageFingerprintSha256", "families",
    "status", "issues", "reconciliationFingerprintSha256"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "manifestType": {"const": "world-builder-discovery-reconciliation"},
    "adapterId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"},
    "representation": {"const": "packed"},
    "sourceFingerprintSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
    "outputPackageFingerprintSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
    "families": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/family"}, {"properties": {"family": {"const": "boundary"}}}]},
        {"allOf": [{"$ref": "#/$defs/family"}, {"properties": {"family": {"const": "ground-item"}}}]},
        {"allOf": [{"$ref": "#/$defs/family"}, {"properties": {"family": {"const": "npc"}}}]},
        {"allOf": [{"$ref": "#/$defs/family"}, {"properties": {"family": {"const": "scenery"}}}]}
      ],
      "items": false
    },
    "status": {"const": "matched"},
    "issues": {"type": "array", "maxItems": 0},
    "reconciliationFingerprintSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"}
  },
  "$defs": {
    "count": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family", "declaredBaseRecords", "declaredOverlayRecords",
        "declaredRemovalRecords", "embeddedMarkersRead",
        "embeddedPlacementsNormalized", "replacementsApplied",
        "removalsApplied", "effectiveRecords", "emittedRecords",
        "packageRecords", "definitionsResolved", "sourceRoles",
        "sourceProvenanceSha256", "effectiveIdentitySha256",
        "packageIdentitySha256", "status"
      ],
      "properties": {
        "family": {"enum": ["boundary", "ground-item", "npc", "scenery"]},
        "declaredBaseRecords": {"$ref": "#/$defs/count"},
        "declaredOverlayRecords": {"$ref": "#/$defs/count"},
        "declaredRemovalRecords": {"$ref": "#/$defs/count"},
        "embeddedMarkersRead": {"$ref": "#/$defs/count"},
        "embeddedPlacementsNormalized": {"$ref": "#/$defs/count"},
        "replacementsApplied": {"$ref": "#/$defs/count"},
        "removalsApplied": {"$ref": "#/$defs/count"},
        "effectiveRecords": {"$ref": "#/$defs/count"},
        "emittedRecords": {"$ref": "#/$defs/count"},
        "packageRecords": {"$ref": "#/$defs/count"},
        "definitionsResolved": {"$ref": "#/$defs/count"},
        "sourceRoles": {
          "type": "array", "minItems": 1, "maxItems": 256,
          "uniqueItems": true,
          "items": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/identifier"}
        },
        "sourceProvenanceSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
        "effectiveIdentitySha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
        "packageIdentitySha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
        "status": {"const": "matched"}
      },
      "allOf": [
        {
          "if": {"properties": {"family": {"not": {"const": "scenery"}}}},
          "then": {
            "properties": {
              "embeddedMarkersRead": {"const": 0},
              "embeddedPlacementsNormalized": {"const": 0}
            }
          }
        }
      ]
    }
  }
}
