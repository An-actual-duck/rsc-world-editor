{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsc-world-editor.invalid/world-builder/project-revision-v1.schema.json",
  "title": "World Builder immutable project revision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "manifestType", "revisionId", "projectId", "createdAt",
    "reason", "description", "parentRevisionId", "sourceSha256",
    "definitionsSha256", "runtimeSha256", "workingPackageFingerprintSha256",
    "fileCount", "totalBytes", "files", "revisionFingerprintSha256"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "manifestType": {"const": "world-builder-project-revision"},
    "revisionId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/uuid"},
    "projectId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/uuid"},
    "createdAt": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/timestamp"},
    "reason": {"enum": ["editing-session", "before-restore", "explicit-backup"]},
    "description": {"type": "string", "maxLength": 1024},
    "parentRevisionId": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/optionalUuid"},
    "sourceSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
    "definitionsSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
    "runtimeSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
    "workingPackageFingerprintSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"},
    "fileCount": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "totalBytes": {"type": "integer", "minimum": 1},
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000000,
      "items": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/inventoryRecord"}
    },
    "revisionFingerprintSha256": {"$ref": "adaptive-contract-definitions-v1.schema.json#/$defs/sha256"}
  }
}
